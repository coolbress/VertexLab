{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>astral-sh/renovate-config"
  ],
  "prConcurrentLimit": 5,
  "schedule": [
    "before 9am on Monday"
  ],
  "packageRules": [
    {
      "matchManagers": [
        "uv"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "digest"
      ],
      "groupName": "GitHub Actions digests",
      "groupSlug": "github-actions-digests",
      "pinDigests": true
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch"
      ],
      "groupName": "GitHub Actions versions",
      "groupSlug": "github-actions-versions"
    },
    {
      "matchPackageNames": [
        "pandas",
        "ipython"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false,
      "description": "Disabled while Python 3.9 is supported. Remove when minimum Python version raises to 3.10+."
    }
  ]
}
