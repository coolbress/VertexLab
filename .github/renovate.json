{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>astral-sh/renovate-config"
  ],
  "schedule": [
    "before 9am on Monday"
  ],
  "packageRules": [
    {
      "matchManagers": [
        "uv"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "pinDigests": true
    }
  ]
}
